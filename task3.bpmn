      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PostTripInspection_di" bpmnElement="Task_PostTripInspection">
        <dc:Bounds x="1830" y="275" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MaintNeeded_di" bpmnElement="Gateway_MaintNeeded" isMarkerVisible="true">
        <dc:Bounds x="2080" y="290" width="50" height="50" />
