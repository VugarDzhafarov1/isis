<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FleetShort" targetNamespace="http://example.com/fleet-accounting-short" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:process id="Process_FleetAccountingShort" name="Учёт автопарка" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="ИС / Бухгалтерия">
        <bpmn:flowNodeRef>Task_UpdateData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Driver" name="Водитель">
        <bpmn:flowNodeRef>Task_ReceiveVehicle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteTrip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnVehicle</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mechanic" name="Механик">
        <bpmn:flowNodeRef>Task_PreTripInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairReplace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostTripInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleMaintenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TechOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MaintNeeded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dispatcher" name="Диспетчер">
        <bpmn:flowNodeRef>Task_RegisterRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectVehicleDriver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseTrip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Поступила заявка на автомобиль">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegisterRequest" name="Зарегистрировать заявку">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectVehicleDriver" name="Выбрать автомобиль из автопарка">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PreTripInspection" name="Провести предрейсовый осмотр">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TechOK" name="ТС исправно?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RepairReplace" name="Направить ТС на ремонт / выбрать другое ТС">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveVehicle" name="Выдать автомобиль и путевой лист">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_ExecuteTrip" name="Выполнить рейс">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_ReturnVehicle" name="Зафиксировать пробег и расход топлива">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PostTripInspection" name="Провести послерейсовый осмотр">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MaintNeeded" name="Требуется ТО/ремонт?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ScheduleMaintenance" name="Запланировать ТО / ремонт">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UpdateData" name="Обновить карточку автомобиля">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CloseTrip" name="Закрыть путевой лист">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GenerateReport" name="Сформировать отчёт по автопарку">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Данные автопарка обновлены">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_RegisterRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RegisterRequest" targetRef="Task_SelectVehicleDriver" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SelectVehicleDriver" targetRef="Task_PreTripInspection" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PreTripInspection" targetRef="Gateway_TechOK" />
    <bpmn:sequenceFlow id="Flow_5" name="Да" sourceRef="Gateway_TechOK" targetRef="Task_ReceiveVehicle" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_RepairReplace" targetRef="Task_SelectVehicleDriver" />
    <bpmn:sequenceFlow id="Flow_7" name="Нет" sourceRef="Gateway_TechOK" targetRef="Task_RepairReplace" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ReceiveVehicle" targetRef="Task_ExecuteTrip" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ExecuteTrip" targetRef="Task_ReturnVehicle" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ReturnVehicle" targetRef="Task_PostTripInspection" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_PostTripInspection" targetRef="Gateway_MaintNeeded" />
    <bpmn:sequenceFlow id="Flow_12" name="Да" sourceRef="Gateway_MaintNeeded" targetRef="Task_ScheduleMaintenance" />
    <bpmn:sequenceFlow id="Flow_13" name="Нет" sourceRef="Gateway_MaintNeeded" targetRef="Task_UpdateData" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ScheduleMaintenance" targetRef="Task_UpdateData" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_UpdateData" targetRef="Task_CloseTrip" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CloseTrip" targetRef="Task_GenerateReport" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_GenerateReport" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_FleetAccountingShort">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="160" y="550" width="2840" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Driver_di" bpmnElement="Lane_Driver" isHorizontal="true">
        <dc:Bounds x="160" y="400" width="2840" height="150" />
