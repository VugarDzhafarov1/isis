      <bpmndi:BPMNShape id="Lane_Mechanic_di" bpmnElement="Lane_Mechanic" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="2840" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dispatcher_di" bpmnElement="Lane_Dispatcher" isHorizontal="true">
