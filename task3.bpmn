        <dc:Bounds x="2200" y="275" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateData_di" bpmnElement="Task_UpdateData">
        <dc:Bounds x="2200" y="590" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CloseTrip_di" bpmnElement="Task_CloseTrip">
        <dc:Bounds x="2480" y="113" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateReport_di" bpmnElement="Task_GenerateReport">
        <dc:Bounds x="2480" y="590" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="2740" y="612" width="36" height="36" />
