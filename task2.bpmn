<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Registration" targetNamespace="http://example.com/registration" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.29.0">
  <bpmn:collaboration id="Collaboration_Registration">
    <bpmn:participant id="Participant_Registration" name="Регистрация пользователя на сайте" processRef="Process_Registration" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Registration" name="Регистрация пользователя на сайте" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Registration">
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_SendMail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuccessNotice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fix</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Task_SendMail" name="Отправить письмо для подтверждения" />
    <bpmn:userTask id="Task_Confirm" name="Подтвердить регистрацию по ссылке из письма" />
    <bpmn:serviceTask id="Task_Verify" name="Проверить подтверждение" />
    <bpmn:serviceTask id="Task_Create" name="Создать учётную запись" />
    <bpmn:userTask id="Task_SuccessNotice" name="Получить уведомление об успешной регистрации" />
    <bpmn:endEvent id="EndEvent_1" name="Регистрация завершена" />
    <bpmn:serviceTask id="Task_Error" name="Показать ошибки в форме" />
    <bpmn:startEvent id="StartEvent_1" name="Начало" />
    <bpmn:userTask id="Task_Enter" name="Ввести имя, email и пароль" />
    <bpmn:serviceTask id="Task_GetData" name="Получить данные" />
    <bpmn:serviceTask id="Task_Check" name="Проверить корректность данных" />
    <bpmn:userTask id="Task_Fix" name="Исправить данные" />
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Данные корректны?" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Да" sourceRef="Gateway_Valid" targetRef="Task_SendMail" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SendMail" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Confirm" targetRef="Task_Verify" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Verify" targetRef="Task_Create" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Create" targetRef="Task_SuccessNotice" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_SuccessNotice" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_No" name="Нет" sourceRef="Gateway_Valid" targetRef="Task_Error" />
    <bpmn:sequenceFlow id="Flow_ErrorFix" sourceRef="Task_Error" targetRef="Task_Fix" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Enter" />
    <bpmn:sequenceFlow id="Flow_FixBack" sourceRef="Task_Fix" targetRef="Task_Enter" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Enter" targetRef="Task_GetData" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_GetData" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Check" targetRef="Gateway_Valid" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Registration">
    <bpmndi:BPMNPlane id="BPMNPlane_Registration" bpmnElement="Collaboration_Registration">
      <bpmndi:BPMNShape id="Participant_Registration_di" bpmnElement="Participant_Registration" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1500" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="180" y="380" width="1470" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="1470" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendMail_di" bpmnElement="Task_SendMail">
        <dc:Bounds x="940" y="450" width="205" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_di" bpmnElement="Task_Confirm">
        <dc:Bounds x="950" y="180" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify">
        <dc:Bounds x="1210" y="450" width="200" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Create_di" bpmnElement="Task_Create">
        <dc:Bounds x="1450" y="450" width="160" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SuccessNotice_di" bpmnElement="Task_SuccessNotice">
        <dc:Bounds x="1330" y="180" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1580" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1566" y="238" width="65" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Error_di" bpmnElement="Task_Error">
        <dc:Bounds x="655" y="595" width="190" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="220" y="195" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="219" y="231" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Enter_di" bpmnElement="Task_Enter">
        <dc:Bounds x="285" y="180" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetData_di" bpmnElement="Task_GetData">
        <dc:Bounds x="285" y="450" width="190" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check">
        <dc:Bounds x="515" y="450" width="210" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fix_di" bpmnElement="Task_Fix">
        <dc:Bounds x="660" y="185" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Valid_di" bpmnElement="Gateway_Valid" isMarkerVisible="true">
        <dc:Bounds x="795" y="435" width="70" height="70" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="397.5" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="256" y="214" />
        <di:waypoint x="285" y="214" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="380" y="260" />
        <di:waypoint x="380" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="475" y="485" />
        <di:waypoint x="515" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="725" y="475" />
        <di:waypoint x="760" y="475" />
        <di:waypoint x="760" y="473" />
        <di:waypoint x="798" y="473" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="830" y="505" />
        <di:waypoint x="830" y="560" />
        <di:waypoint x="750" y="560" />
        <di:waypoint x="750" y="595" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="782" y="537" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ErrorFix_di" bpmnElement="Flow_ErrorFix">
        <di:waypoint x="750" y="595" />
        <di:waypoint x="750" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FixBack_di" bpmnElement="Flow_FixBack">
        <di:waypoint x="660" y="220" />
        <di:waypoint x="475" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="862" y="473" />
        <di:waypoint x="903" y="473" />
        <di:waypoint x="903" y="477" />
        <di:waypoint x="940" y="477" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="877" y="449" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1042" y="450" />
        <di:waypoint x="1042" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1170" y="220" />
        <di:waypoint x="1310" y="220" />
        <di:waypoint x="1310" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1410" y="485" />
        <di:waypoint x="1450" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1530" y="450" />
        <di:waypoint x="1530" y="260" />
        <di:waypoint x="1435" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1540" y="220" />
        <di:waypoint x="1580" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
